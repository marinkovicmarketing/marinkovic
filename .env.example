DATABASE_URL="file:./dev.db"

# Claude API key — used to generate tips from match data
ANTHROPIC_API_KEY=

# Telegram bot token from @BotFather — used to deliver tips
TELEGRAM_BOT_TOKEN=

# API-Football key (https://www.api-football.com/) — fixtures & team stats.
# Leave empty to run the generator against mock fixtures for local testing.
API_FOOTBALL_KEY=

# Shared access code for VIP content until real payments are wired up.
# Share this manually with paying customers; change it whenever needed.
VIP_ACCESS_CODE=promeni-me

# Manual PayPal payment flow (shown on the locked /vip page and in the bot).
# VIP_PRICE is freeform display text, e.g. "9,99 €/Monat".
VIP_PRICE=9,99 €/Monat
VIP_PAYPAL_LINK=paypal.me/deinname
VIP_CONTACT_TELEGRAM=@deinnutzername
